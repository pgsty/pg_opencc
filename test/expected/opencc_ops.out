-- versions: the dictionary digest identifies the embedded data
SELECT extension, opencc, dictionary ~ '^sha256:[0-9a-f]{64}$' AS digest_ok FROM opencc.version();
 extension | opencc | digest_ok 
-----------+--------+-----------
 0.1.0     | 1.4.2  | t
(1 row)

